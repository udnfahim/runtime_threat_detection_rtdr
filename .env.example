# Copy to .env and fill values
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/rtdr
SPRING_DATASOURCE_USERNAME=rtdr_user
SPRING_DATASOURCE_PASSWORD=rtdr_pass
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SECURITY_OAUTH2_JWK-SET-URI=https://auth.example.com/.well-known/jwks.json
SECURITY_TELEMETRY_AGENT-TOKEN=change-me-secure-token
